{
  "name": "closure-call",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/run-api.mjs",
    "dev:web": "npm --prefix frontend run dev",
    "setup": "node scripts/setup.mjs",
    "test": "node scripts/run-api.mjs --test",
    "build:history": "node scripts/run-api.mjs --history",
    "build:daily-history": "node scripts/run-api.mjs --daily-history",
    "cache:cameras": "node scripts/run-api.mjs --cameras",
    "seed:examples": "node scripts/run-api.mjs --examples",
    "backtest:ai": "node scripts/run-api.mjs --backtest-ai",
    "analyze:risk": "node scripts/run-api.mjs --analyze-risk",
    "dataset:cloud": "node scripts/run-api.mjs --dataset-cloud",
    "dataset:repo": "node scripts/run-api.mjs --dataset-repo"
  },
  "devDependencies": {
    "concurrently": "8.2.2"
  }
}
