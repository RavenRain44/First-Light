# Public front door: HTTPS (automatic Let's Encrypt certificate) in front of the app.
# deploy/manager-auth (written by deploy/scripts/setup-linode.sh) either adds a manager login for
# recording decisions, notifications and storage actions, or is a comment only (no login).
{$SITE_ADDRESS} {
	encode zstd gzip

	import /etc/caddy/manager-auth

	reverse_proxy app:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
