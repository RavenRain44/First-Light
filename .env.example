# Copy to .env (repo root). Never commit .env.

# Local API port. Change this if another service already uses port 8000.
API_PORT=8000

# NWS asks every client to identify itself with an app name + contact (URL or email).
NWS_USER_AGENT="ClosureCall-HackMidwest2026 (https://github.com/RavenRain44/hack-midwest-2026)"

# Serve every source from backend/fixtures/http_cache (no network) except Live Check.
DEMO_MODE=false

# Optional: periodic live re-evaluation in seconds (0 = only on request / when stale)
REFRESH_INTERVAL_SECONDS=0
SNAPSHOT_STALE_SECONDS=600
LIVE_CACHE_TTL_SECONDS=600
# DATABASE_PATH=backend/var/closurecall.db

# Akamai workshop inference. Keep the team key on the backend and out of Git.
# Endpoint: https://ws.akamai-workshops.com/v1; model alias: hackathon-chat.
# MODEL_PROVIDER=none disables all inference (e.g. offline tests/history builds).
MODEL_PROVIDER=akamai
AKAMAI_API_KEY=
# Strands fallback through Amazon Bedrock. Uses the normal AWS credential chain
# and requires access to the selected model in this region.
STRANDS_FALLBACK_ENABLED=true
STRANDS_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1

# Real tests ONLY to contacts in backend/notification-contacts.local.json.
# Email: use your provider's SMTP credentials; keep secrets in ignored .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Akamai Object Storage (S3-compatible): mirrors the decision log, chart data, decision camera stills and
# daily database backups to a private bucket. Leave the bucket or keys empty to keep everything local.
# Create the bucket and a bucket-limited access key in Akamai Cloud Manager (see docs/akamai-usage.md).
OBJ_ENDPOINT=https://us-ord-10.linodeobjects.com
OBJ_REGION=us-ord
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=
# Folder inside the bucket. Use OBJ_PREFIX=dev on laptops so local test data never mixes with the server's.
OBJ_PREFIX=
OBJ_BACKUP_HOURS=24
# Load the frozen 30-year backtesting dataset from the bucket's shared datasets/ folder when missing locally.
DATASET_AUTO_RESTORE=true
# Which published dataset to load: ames-forecast-v1 (2019+, archived forecasts, corrected labels) or ames-7470-v1 (old).
DATASET_VERSION=ames-forecast-v1

# Production front door (deploy/compose.prod.yaml). The public address Caddy serves with HTTPS:
# a domain you point at the Linode, or its free hostname. Written by deploy/scripts/setup-linode.sh.
SITE_ADDRESS=

# Decision feedback: optional server-side manager authorization for policy approval,
# activation and rollback. Use a random token; never use the Akamai API key here.
# Empty disables those actions. Keep the deployed site behind its manager login.
THRESHOLD_ADMIN_TOKEN=
