# Copy to .env (repo root). Never commit .env.

# NWS asks every client to identify itself with an app name + contact (URL or email).
NWS_USER_AGENT="ClosureCall-HackMidwest2026 (https://github.com/RavenRain44/hack-midwest-2026)"

# Serve every source from backend/fixtures/http_cache (no network) except Live Check.
DEMO_MODE=false

# Optional: periodic live re-evaluation in seconds (0 = only on request / when stale)
REFRESH_INTERVAL_SECONDS=0
SNAPSHOT_STALE_SECONDS=600
LIVE_CACHE_TTL_SECONDS=600
# DATABASE_PATH=backend/var/closurecall.db

# Akamai workshop inference for briefs and staff email/SMS drafts.
# Set none for offline templates.
MODEL_PROVIDER=akamai
AKAMAI_API_KEY=
# Optional AWS brief fallback (staff messages still use Akamai or templates).
AWS_FALLBACK_ENABLED=false
AWS_BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

# Optional real tests to locally allowlisted contacts only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
